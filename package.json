{
  "name": "@fbuireu/fbuireu-cli",
  "version": "2.0.0",
  "description": "An executable business card: Ferran Buireu's portfolio, in your terminal",
  "keywords": [
    "cli",
    "portfolio",
    "resume",
    "cv",
    "business-card",
    "npx",
    "interactive",
    "terminal",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "fbuireu": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fbuireu/fbuireu-cli.git"
  },
  "author": "Ferran Buireu <fbuireu@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": "v26.5.1"
  },
  "packageManager": "pnpm@11.21.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepare": "husky",
    "build": "tsx esbuild.config.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:changed": "vitest run --changed HEAD",
    "lint": "biome check --no-errors-on-unmatched .",
    "format": "pnpm run lint --write",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test:coverage",
    "validate": "pnpm run check && pnpm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@commitlint/format": "21.2.0",
    "@commitlint/types": "21.2.0",
    "@inquirer/prompts": "8.5.2",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/npm": "13.1.5",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "chalk": "6.0.0",
    "esbuild": "0.28.2",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "ora": "9.4.1",
    "semantic-release": "25.0.9",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "bugs": {
    "url": "https://github.com/fbuireu/fbuireu-cli/issues"
  },
  "homepage": "https://github.com/fbuireu/fbuireu-cli#readme"
}
